EXPO_PUBLIC_SHOPIFY_DOMAIN=haramaineg.com
EXPO_PUBLIC_SHOPIFY_SHOP_ID=59682848873
# Optional: tokenless Storefront access works for reads/cart; add a token for higher limits.
EXPO_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
# From Shopify Admin > Sales channels > Headless/Hydrogen > Customer Account API
EXPO_PUBLIC_CUSTOMER_ACCOUNT_CLIENT_ID=
# Railway API public URL, e.g. https://haramain-api.up.railway.app
EXPO_PUBLIC_API_URL=
# Store WhatsApp number in international format, e.g. 201012345678
EXPO_PUBLIC_WHATSAPP_NUMBER=
