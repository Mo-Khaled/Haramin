{
  "expo": {
    "name": "Haramain",
    "slug": "haramain",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "haramain",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.haramain.app",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ExpoLocalization_supportsRTL": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6E2931",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.haramain.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#FBF9EE",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#160E0E"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-notifications",
      "expo-web-browser",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://de.sentry.io/",
          "organization": "haramin",
          "project": "haramain-app"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "supportsRTL": true,
      "eas": {
        "projectId": "1115ca0f-b760-484b-8ce0-a7cba9e80f82"
      },
      "router": {}
    },
    "owner": "mo_4222",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1115ca0f-b760-484b-8ce0-a7cba9e80f82"
    }
  }
}
